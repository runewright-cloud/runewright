# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Raw third-party art sources (unpacked OpenGameArt archives). Never vendored --
# docs/SPELL_ART_PACK_PLAN.md D-2: regenerate assets/art_pack/ from these via
# scripts/build_art_pack.py rather than committing 33 MB of source PNGs. The
# derived assets/art_pack/ directory IS tracked and is not covered by this rule.
/assets/art/

# Raw third-party audio sources (unpacked OpenGameArt archive). Never vendored --
# docs/SPELL_SOUND_PACK_PLAN.md D-2/A-2: regenerate assets/sound_pack/ from these via
# scripts/build_sound_pack.py rather than committing 21 MB of source WAV/Ogg. These
# were tracked in git through commit 4908565 and remain in history there -- that is
# fine and not worth rewriting; only the tree and future clones need to stay lean.
# The derived assets/sound_pack/ directory IS tracked and is not covered by this rule.
/assets/audio/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Noir circuit build artifacts — keep VK + ACIR bytecode, ignore bulk proving artifacts
circuits/*/target/proof/
circuits/*/target/*.gz
# Keep: circuits/*/target/*.json  (ACIR bytecode)
# Keep: circuits/*/target/vk/     (verification key — M2 FFI links against it)

# Rust FFI bridge build output
/ffi/target/
